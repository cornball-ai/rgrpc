export(grpc_call)
export(grpc_cancel)
export(grpc_client)
export(grpc_close)
export(grpc_decode)
export(grpc_fd)
export(grpc_method)
export(grpc_pending)
export(grpc_poll)
export(grpc_reply)
export(grpc_server)
export(grpc_server_port)
export(grpc_service)
export(grpc_status_codes)
export(grpc_version)

S3method(grpc_close,grpc_client)
S3method(grpc_close,grpc_server)
S3method(grpc_fd,grpc_client)
S3method(grpc_fd,grpc_server)
S3method(grpc_pending,grpc_client)
S3method(grpc_pending,grpc_server)
S3method(grpc_poll,grpc_client)
S3method(grpc_poll,grpc_server)

importFrom(methods,as)

useDynLib(grpc, .registration = TRUE)
